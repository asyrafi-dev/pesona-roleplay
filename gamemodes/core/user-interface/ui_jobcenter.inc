{
	for(new x; x < 35; x++)
	{
		TextDrawShowForPlayer(playerid, JobCenterTD[x]);
	}
	HideHBETD(playerid);
	HideStatsTD(playerid);
	HideServerNameTD(playerid);
	SelectTextDraw(playerid, 0xff91a4cc);
}

HideJobCenterTD(playerid)
{
	for(new x; x < 35; x++)
	{
		TextDrawHideForPlayer(playerid, JobCenterTD[x]);
