ShowStarterpackTD(playerid)
{
    HideHBETD(playerid);
    HideStatsTD(playerid);
    //HideRadioVoiceInfoTD(playerid);
    HideServerNameTD(playerid);
    for(new x; x < 27; x++)
    {
        TextDrawShowForPlayer(playerid, StarterpackTD[x]);
    }
    SelectTextDraw(playerid, 0xff91a4cc);
}

HideStarterpackTD(playerid)
{
    for(new x; x < 27; x++)
    {
        TextDrawHideForPlayer(playerid, StarterpackTD[x]);
    }
    ShowHBETD(playerid);
    ShowStatsTD(playerid);
    ShowServerNameTD(playerid);
    CancelSelectTextDraw(playerid); 
}